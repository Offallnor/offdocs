,"sak_type":"alminneligsak"},{"id":"40037195","sesjon":"2026-2027","dato":"2026-11-17T00:00:00","sak_id":"200327","vedtak_nummer":47,"tittel":"Endringer i tobakksskadeloven (endringer i gebyr- og avgiftssystemet og høyere strafferammer)","tekst":"Stortinget ber regjeringen ved gjennomføringen legge til rette for en 18 måneders overgangsperiode, slik at arbeidsgiverne kan ivareta sitt ansvar etter arbeidsmiljøregelverket, gjennomføre nødvendige organisatoriske og bemanningsmessige tilpasninger og sikre reell medvirkning fra ansatte og tillitsvalgte.","sak_url":"https://www.stortinget.no/no/Saker-og-publikasjoner/Saker/Sak/?p=200327","vedtak_url":"https://www.stortinget.no/no/Saker-og-publikasjoner/Vedtak/Vedtak/Sak/?did=40037195&p=200327","komite":"Helse- og omsorgskomiteen","emne":[],"stikkord":[],"henvisning":"Prop. 97 L (2025-2026), Innst. 29 L (2026-2027), Lovvedtak 1 (2026-2027)","dokumentgruppe":"proposisjon","sak_type":"lovsak"},{"id":"40037196","sesjon":"2026-2027","dato":"2026-11-17T00:00:00","sak_id":"200192","vedtak_nummer":48,"tittel":"Representantforslag om utredning av selvbestemt livsavslutning","tekst":"Stortinget ber regjeringen på egnet måte sikre at pasienter gjøres godt kjent med de muligheter de har for medbestemmelse i livets siste fase, og at god lindrende behandling skal tilbys, også innenfor dagens lovverk.","sak_url":"https://www.stortinget.no/no/Saker-og-publikasjoner/Saker/Sak/?p=200192","vedtak_url":"https://www.stortinget.no/no/Saker-og-publikasjoner/Vedtak/Vedtak/Sak/?did=40037196&p=200192","komite":"Helse- og omsorgskomiteen","emne":[],"stikkord":[],"henvisning":"Dokument 8:264 S (2025-2026), Innst. 21 S (2026-2027)","dokumentgruppe":"representantforslag","sak_type":"alminneligsak"}]